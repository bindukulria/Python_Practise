import tkinter as tk
from tkinter import ttk
import math

# Global variables for calculator state
op = "" 
n1 = 0.0
n2 = 0.0
r = 0.0
memory = 0.0  # Stores memory values (M+, MS, etc.)
is_start_of_input = True  # Tracks if next digit press should clear/overwrite screen

def btndigit_click(digit):
    global is_start_of_input
    current = txtnum.get()
    
    # Overwrite if starting a new number context (like right after an operator or error)
    if is_start_of_input or current == "Error: Division by zero":
        txtnum.delete(0, tk.END)
        txtnum.insert(0, str(digit))
        is_start_of_input = False
    else:
        txtnum.insert(tk.END, str(digit))

def op_click(operator):
    global op, n1, is_start_of_input
    try:
        op = operator
        n1 = float(txtnum.get())
        is_start_of_input = True  # Ready to accept second number
    except ValueError:
        pass

def equal_click():
    global op, n1, n2, r, is_start_of_input
    try:
        n2 = float(txtnum.get())
        if op == "+":
            r = n1 + n2
        elif op == "-":
            r = n1 - n2
        elif op == "*":
            r = n1 * n2
        elif op == "/":
            if n2 != 0:
                r = n1 / n2
            else:
                txtnum.delete(0, tk.END)
                txtnum.insert(0, "Error: Division by zero")
                is_start_of_input = True
                return
        else:
            return # No operation selected
            
        # Format out trailing decimals if it's a whole number
        if r.is_integer():
            r = int(r)
            
        txtnum.delete(0, tk.END)
        txtnum.insert(0, str(r))
        is_start_of_input = True
    except ValueError:
        pass

# --- NEW FUNCTIONALITIES ---

def clear_all():
    """ Resets the calculator entirely (C Button) """
    global op, n1, n2, r, is_start_of_input
    op = ""
    n1, n2, r = 0, 0, 0
    txtnum.delete(0, tk.END)
    txtnum.insert(0, "0")
    is_start_of_input = True

def clear_entry():
    """ Clears just the current entry field (CE Button) """
    txtnum.delete(0, tk.END)
    txtnum.insert(0, "0")
    global is_start_of_input
    is_start_of_input = True

def backspace():
    """ Deletes the last typed digit (⌫ Button) """
    current = txtnum.get()
    if current and current != "Error: Division by zero":
        txtnum.delete(len(current) - 1, tk.END)
        if txtnum.get() == "":
            txtnum.insert(0, "0")
            global is_start_of_input
            is_start_of_input = True

def dot_click():
    """ Appends a decimal point safely without duplication """
    global is_start_of_input
    if is_start_of_input:
        txtnum.delete(0, tk.END)
        txtnum.insert(0, "0.")
        is_start_of_input = False
    else:
        current = txtnum.get()
        if "." not in current:
            txtnum.insert(tk.END, ".")

def toggle_sign():
    """ Flips number between positive and negative (± Button) """
    try:
        current = float(txtnum.get())
        if current != 0:
            current = -current
            if current.is_integer():
                current = int(current)
            txtnum.delete(0, tk.END)
            txtnum.insert(0, str(current))
    except ValueError:
        pass

def advanced_op(func):
    """ Handles instant unary mathematical operations (√, %, 1/x) """
    try:
        val = float(txtnum.get())
        if func == "sqrt":
            if val >= 0:
                res = math.sqrt(val)
            else:
                txtnum.delete(0, tk.END)
                txtnum.insert(0, "Invalid Input")
                return
        elif func == "percent":
            res = val / 100
        elif func == "fraction":
            if val != 0:
                res = 1 / val
            else:
                txtnum.delete(0, tk.END)
                txtnum.insert(0, "Error: Division by zero")
                return
                
        if res.is_integer():
            res = int(res)
        txtnum.delete(0, tk.END)
        txtnum.insert(0, str(res))
    except ValueError:
        pass

# --- MEMORY FUNCTIONALITIES ---

def memory_control(action):
    global memory, is_start_of_input
    try:
        current_val = float(txtnum.get())
    except ValueError:
        current_val = 0.0

    if action == "MC":
        memory = 0.0
        lblmem.config(text="") # Clear memory label
    elif action == "MR":
        if memory.is_integer():
            m_display = int(memory)
        else:
            m_display = memory
        txtnum.delete(0, tk.END)
        txtnum.insert(0, str(m_display))
        is_start_of_input = True
    elif action == "MS":
        memory = current_val
        lblmem.config(text="M" if memory != 0 else "")
        is_start_of_input = True
    elif action == "M+":
        memory += current_val
        lblmem.config(text="M" if memory != 0 else "")
        is_start_of_input = True


